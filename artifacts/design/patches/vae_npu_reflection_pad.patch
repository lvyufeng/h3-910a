+def _pad_base_format(x, pad, mode):
+    """Repack only NPU reflection padding; preserve dtype and every value.
+
+    ReflectionPad3D on 910A rejects packed NDC1HWC0 Conv3D outputs. Base NCDHW
+    (format 30) is accepted and is exactly equivalent to CPU reflection padding.
+    Do not disable internal layouts globally or change the encoder's FP32 path.
+    """
+    if x.device.type in ("npu", "privateuseone") and mode == "reflect":
+        import torch_npu
+        x = torch_npu.npu_format_cast(x, 30)
+    return F.pad(x, pad, mode=mode)
 
 
