+def _vision_fp32_enabled() -> bool:
+    # Keep unvalidated whole-model generation changes opt-in. This switch changes
+    # vision compute, not stored parameter dtype or global device math settings.
+    import os
+    return os.environ.get("VLLM_OMNI_910A_VISION_FP32", "0").lower() in ("1", "true", "yes", "on")
+
+
+class _NpuBF16CompatibleLinear(nn.Linear):
+    """Keep BF16 parameters/I/O but avoid the 910A BF16 linear fallback.
+
+    On actual 8064-row vision inputs, the native BF16 linear is both much slower
+    and less accurate than FP32 compute followed by a single BF16 output cast.
+    Preserve nn.Linear's names/loaders and all CPU/non-BF16 paths. This does not
+    alter the device-global HF32 policy or cache transformed weight copies.
+    """
+
+    def forward(self, input: torch.Tensor) -> torch.Tensor:
+        if (input.device.type in ("npu", "privateuseone")
+                and input.dtype == torch.bfloat16 and self.weight.dtype == torch.bfloat16
+                and _vision_fp32_enabled()):
+            return F.linear(input.float(), self.weight.float(),
+                            self.bias.float() if self.bias is not None else None).to(input.dtype)
+        return super().forward(input)
+
