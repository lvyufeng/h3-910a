+class _NpuBF16CompatibleLayerNorm(nn.LayerNorm):
+    """Keep BF16 storage/I/O while avoiding the 910A legacy LayerNorm cast.
+
+    The installed BF16 LayerNorm TBE implementation fails to compile its internal
+    BF16->FP32 cast on Ascend910A. Explicit torch casts and stable FP32 reductions
+    work; this is the same normalization formula, not an FP16 model conversion. Native
+    CPU/CUDA and non-BF16 behavior remain unchanged. Parameter names/layout stay
+    identical to nn.LayerNorm so checkpoint loading is unaffected.
+    """
+
+    def _stable_bf16_forward(self, input: torch.Tensor) -> torch.Tensor:
+        # Offset cancellation is important for constant/high-offset rows with
+        # eps=1e-6: the first simple FP32 LayerNorm probe showed a 1e-3 spurious
+        # output on a constant row. Center before reducing, then use a two-pass
+        # variance. The BF16 input values are exactly representable in FP32.
+        x = input.float()
+        flat = x.flatten(start_dim=x.ndim - len(self.normalized_shape))
+        shifted = flat - flat[..., :1]
+        centered = shifted - shifted.mean(dim=-1, keepdim=True)
+        variance = centered.square().mean(dim=-1, keepdim=True)
+        normalized = (centered * torch.rsqrt(variance + self.eps)).reshape(input.shape)
+        if self.weight is not None:
+            normalized = normalized * self.weight.float()
+        if self.bias is not None:
+            normalized = normalized + self.bias.float()
+        return normalized.to(input.dtype)
+
+    def forward(self, input: torch.Tensor) -> torch.Tensor:
+        if input.device.type in ("npu", "privateuseone") and input.dtype == torch.bfloat16:
+            return self._stable_bf16_forward(input)
+        return super().forward(input)
+
