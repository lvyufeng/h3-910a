+def _vision_sdpa_bf16_compatible(q: torch.Tensor, k: torch.Tensor, v: torch.Tensor) -> torch.Tensor:
+    # This stack's vision SDPA math path hits an internal format-alias error at
+    # head_dim=72 with BF16 and FP32, even on contiguous inputs. Avoid that path
+    # for unmasked vision attention using the same QK/softmax/PV formula. Retain
+    # BF16/FP16 storage and result dtype, with FP32 arithmetic (no FP16 cast).
+    if q.device.type in ("npu", "privateuseone"):
+        compute_dtype = torch.float32 if q.dtype in (torch.bfloat16, torch.float16) else q.dtype
+        qf, kf, vf = (tensor.to(compute_dtype).contiguous() for tensor in (q, k, v))
+        scores = torch.matmul(qf, kf.transpose(-2, -1)) * (q.shape[-1] ** -0.5)
+        probabilities = torch.softmax(scores, dim=-1)
+        return torch.matmul(probabilities, vf).to(q.dtype)
+    return F.scaled_dot_product_attention(q.contiguous(), k.contiguous(), v.contiguous(), dropout_p=0.0, is_causal=False)
+
