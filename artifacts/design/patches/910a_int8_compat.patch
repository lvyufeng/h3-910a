+def _dequantize_int8_rows(qdata, weight_scale, start, end, dtype, convrot=False, group_size=256):
+    """Materialize one output-row slice of a device-resident INT8 weight."""
+    qdata_chunk = qdata[start:end].contiguous()
+    if weight_scale.numel() == 1:
+        scale_chunk = weight_scale
+    else:
+        scale_chunk = weight_scale[start:end].reshape(-1, 1)
+
+    if convrot:
+        from comfy_kitchen.backends.eager.quantization import dequantize_int8_convrot_weight
+
+        dequantized = dequantize_int8_convrot_weight(
+            qdata_chunk,
+            scale_chunk,
+            int(group_size),
+        )
+    else:
+        dequantized = qdata_chunk.float() * scale_chunk
+    return dequantized.to(dtype=dtype)
+
+
+def _npu_int8_linear_compat(input, weight, bias=None, input_act=None):
+    """Chunked FP fallback for INT8 weights on Ascend 910A.
+
+    The quantized weight remains in INT8 storage.  Only one output-row block is
+    dequantized at a time, which keeps the temporary FP weight at
+    ``chunk_rows * in_features`` instead of materializing the whole matrix.
+    """
+    if input_act is not None:
+        input = INPUT_ACT_EAGER[input_act](input)
+
+    qdata, weight_scale = TensorWiseINT8Layout.get_plain_tensors(weight)
+    weight_shape = tuple(qdata.shape)
+    scale_count = int(weight_scale.numel())
+    convrot = bool(getattr(weight._params, "convrot", False))
+    group_size = int(getattr(weight._params, "convrot_groupsize", 256))
+    context = (
+        f"weight_shape={weight_shape}, scale_count={scale_count}, "
+        f"input_dtype={input.dtype}, convrot={convrot}, convrot_group_size={group_size}"
+    )
+    if input.dtype != torch.float16:
+        raise TypeError(
+            f"910A INT8 compatibility requires float16 input; {context}"
+        )
+    if qdata.dtype != torch.int8 or qdata.ndim != 2:
+        raise TypeError(
+            f"910A INT8 compatibility expected a 2D int8 weight, got "
+            f"weight_dtype={qdata.dtype}, {context}"
+        )
+    if scale_count not in (1, qdata.shape[0]):
+        raise ValueError(
+            f"910A INT8 compatibility found an invalid weight scale; {context}"
+        )
+    if input.ndim == 0 or input.shape[-1] != qdata.shape[-1]:
+        raise ValueError(
+            f"910A INT8 compatibility input mismatch: input_shape={tuple(input.shape)}; "
+            f"{context}"
+        )
+
+    # Move the complete INT8 weight and its scale once per linear call.  The
+    # chunk loop below only slices these device-resident tensors, avoiding a
+    # full-scale H2D copy for every output-row block.
+    qdata = qdata.to(device=input.device, dtype=torch.int8).contiguous()
+    weight_scale = weight_scale.reshape(-1).to(
+        device=input.device,
+        dtype=torch.float32,
+    )
+
+    input_2d = input.reshape(-1, input.shape[-1])
+    out_features = qdata.shape[0]
+    output_shape = (*input.shape[:-1], out_features)
+    output = torch.empty(
+        (input_2d.shape[0], out_features),
+        dtype=input.dtype,
+        device=input.device,
+    )
+    if input_2d.shape[0] == 0:
+        return output.reshape(output_shape)
+
+    chunk_size = _npu_int8_compat_chunk_size()
+    bias_2d = None if bias is None else bias.to(device=input.device, dtype=input.dtype).reshape(-1)
+
+    for start in range(0, out_features, chunk_size):
+        end = min(start + chunk_size, out_features)
+        weight_chunk = _dequantize_int8_rows(
+            qdata,
+            weight_scale,
+            start,
+            end,
+            input.dtype,
+            convrot=convrot,
+            group_size=group_size,
+        )
+        chunk_output = torch.mm(input_2d, weight_chunk.t())
+        if bias_2d is not None:
+            chunk_output.add_(bias_2d[start:end].reshape(1, -1))
+        output[:, start:end] = chunk_output
+    return output.reshape(output_shape)
+
